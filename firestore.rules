    match /financeTransactions/{transactionId} {
      allow get: if isValidId(transactionId) && isSignedIn() && (isAdmin() || (isTeacher() && existing().createdBy == request.auth.uid));
      allow list: if isSignedIn() && (isTokenAdmin() || resource.data.createdBy == request.auth.uid);
