        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['orderNo', 'fullName', 'birthPlace', 'birthDate', 'gender', 'nuptkNpkPegId', 'tmt', 'position', 'phone', 'address', 'isActive', 'updatedAt']);
      allow delete: if isValidId(teacherId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isTokenAdmin();
      allow create, update, delete: if isValidId(adminId) && isTokenAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isTokenAdmin();
      allow create: if isValidId(userId) &&
        isVerifiedEmail() &&
        isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == userId &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isTokenAdmin() && incoming().role == 'admin') ||
          matchesRoleInvite(incoming()) ||
          (incoming().role == 'pending' && incoming().linkedStudentIds.size() == 0 && incoming().classIds.size() == 0)
        );
      allow update: if isValidId(userId) &&
        isVerifiedEmail() &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            matchesRoleInvite(incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'linkedStudentIds', 'classIds', 'assignedSubjects', 'updatedAt'])
          ) ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().linkedStudentIds == existing().linkedStudentIds &&
            incoming().classIds == existing().classIds &&
            (!('assignedSubjects' in existing()) || incoming().assignedSubjects == existing().assignedSubjects) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (resource == null || existing().isPublic == true);
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isValidId(userId) &&
        isVerifiedEmail() &&
        isValidPublicProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().isPublic == true &&
            (
              incoming().roleLabel == 'Menunggu Verifikasi' ||
