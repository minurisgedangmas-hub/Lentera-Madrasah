        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (isTeacher() && (existing().createdBy == request.auth.uid || (request.auth.uid in existing().teacherUids)))
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['studentIdNumber', 'nisn', 'fullName', 'nik', 'classId', 'className', 'studentUid', 'parentUids', 'teacherUids', 'status', 'gender', 'birthPlace', 'birthDate', 'parentName', 'fatherName', 'motherName', 'phone', 'address', 'entryType', 'entryDate', 'previousSchool', 'graduationYear', 'nextSchool', 'certificateNumber', 'updatedAt']);
      allow delete: if isValidId(studentId) && isAdmin();
    }

    match /studentMutations/{mutationId} {
      allow get: if isValidId(mutationId) && isSignedIn() && (isAdmin() || isTeacher());
