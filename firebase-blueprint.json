      "description": "Madrasah financial ledger entry covering Class KAS 1-6, Student Savings 1-6, Class 6 Mandatory Savings, Course Payments, and Pramuka Extracurricular funds.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["kas_kelas", "tabungan_siswa", "tabungan_wajib_6", "pembayaran_kursus", "ekstra_pramuka"]
        },
        "classLevel": {
          "type": "string",
          "enum": ["Kelas 1", "Kelas 2", "Kelas 3", "Kelas 4", "Kelas 5", "Kelas 6", "Umum"]
        },
        "transactionType": {
          "type": "string",
          "enum": ["Masuk", "Keluar"]
        },
        "amount": {
          "type": "number"
        },
        "transactionDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Lunas", "Cicilan", "Belum Lunas", ""]
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "category", "classLevel", "transactionType", "amount", "transactionDate", "studentId", "studentName", "title", "paymentStatus", "notes", "createdBy", "createdByName", "createdAt", "updatedAt"]
    },
    "AttendanceReportLink": {
      "title": "AttendanceReportLink",
      "description": "External attendance report URL configured per Madrasah class level and rombel for public and portal preview.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "classLevel": {
          "type": "string",
          "enum": ["Kelas 1", "Kelas 2", "Kelas 3", "Kelas 4", "Kelas 5", "Kelas 6"]
        },
        "rombel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "reportUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "HTTPS URL for external attendance report preview"
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "classLevel", "rombel", "reportUrl", "isPublic", "createdBy", "updatedBy", "updatedByName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/madrasahProfile/{profileId}": {
      "schema": { "$ref": "#/entities/MadrasahIdentity" },
      "description": "Official institutional profile of the Madrasah Ibtidaiyah (MI)"
    },
    "/attendanceReportLinks/{linkId}": {
      "schema": { "$ref": "#/entities/AttendanceReportLink" },
      "description": "External attendance report links separated by class level (Kelas 1-6) and rombel"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user account profiles with RBAC role and PII email"
    },
    "/publicProfiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Non-PII school directory profiles"
    },
    "/roleInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/RoleInvite" },
      "description": "Admin-managed role assignment invitations"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/SchoolClass" },
      "description": "School class configurations"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student roster records linked to classes and parent/student UIDs"
    },
    "/grades/{gradeId}": {
      "schema": { "$ref": "#/entities/Grade" },
      "description": "Student assessment grades"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Daily student attendance records"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "School activity announcements"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time notifications for grades, attendance, and announcements"
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Madrasah teacher and staff personnel directory (PII restricted to admin)"
    },
    "/studentMutations/{mutationId}": {
      "schema": { "$ref": "#/entities/StudentMutation" },
      "description": "Student transfer-in and transfer-out (mutasi) history logs"
    },
    "/financeTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/FinanceTransaction" },
      "description": "Madrasah financial ledger records (KAS Kelas 1-6, Tabungan Siswa 1-6, Tabungan Wajib Kelas 6, Pembayaran Kursus, Ekstra Pramuka)"
    }
  }
}
