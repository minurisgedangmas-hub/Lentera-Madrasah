{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user account profile containing RBAC role and PII email.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified Google account email"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full display name"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "guru", "siswa", "orangtua", "pending"],
          "description": "Server-validated user role"
        },
        "linkedStudentIds": {
          "type": "array",
          "description": "Bounded list of linked student IDs (max 10)"
        },
        "classIds": {
          "type": "array",
          "description": "Bounded list of assigned class IDs (max 15)"
        },
        "assignedSubjects": {
          "type": "array",
          "description": "Bounded list of subjects assigned to teacher (max 20)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "role", "linkedStudentIds", "classIds", "createdAt", "updatedAt"]
    },
